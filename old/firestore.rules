rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function admin() { return signedIn() && profile().perfil == 'admin' && profile().ativo != false; }
    match /{document=**} { allow read, write: if admin(); }
    match /usuarios/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create, update, delete: if admin(); }
  }
}
