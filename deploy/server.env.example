# Contrato do FUTURO backend. O front atual NÃO lê estas variáveis.
# Valores institucionais devem ser preenchidos fora do Git, após escolha da arquitetura.
NODE_ENV=production
APP_ORIGIN=https://prgd.ati.example.invalid
DATABASE_URL=
DATABASE_SSL_CA_FILE=/etc/prgd/certs/postgres-ca.pem
SESSION_SIGNING_KEY=
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Alternativa a implementar somente no servidor: LDAPS com CA confiável.
LDAP_URL=ldaps://ldap.ati.example.invalid:636
LDAP_CA_FILE=/etc/prgd/certs/ldap-ca.pem
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_USER_FILTER=(uid={username})
