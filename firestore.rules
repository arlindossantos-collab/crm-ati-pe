rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function active() {
      let user = profile();
      return signedIn() && user != null && user.get('ativo', true) == true && user.get('excluido', false) != true;
    }
    function isAdmin() {
      // Administradores antigos continuam acessando até a classificação manual.
      let user = profile();
      return signedIn() && user != null && user.get('ativo', true) == true && user.get('excluido', false) != true
        && user.get('tipoUsuario', '') != 'externo' && user.get('perfil', '') == 'admin';
    }
    function hasInstitutionalAccess() { return profile().get('acessoInstitucional', null) != null; }
    function baseAccessActive(user) {
      let v = user.get('acessoInstitucional', {});
      return user.get('ativo', true) == true && user.get('excluido', false) != true
        && v is map && v.get('situacao', '') == 'aprovado'
        && v.get('papel', '') in ['grgd','gestor_nsi','substituto','auditoria']
        && v.inicio <= request.time.toMillis() && v.fim > request.time.toMillis() && v.revisao > request.time.toMillis();
    }
    function validSubstitute(v) {
      let titular = get(/databases/$(database)/documents/usuarios/$(v.titularUid)).data;
      let t = titular.acessoInstitucional;
      return v.titularUid != request.auth.uid && baseAccessActive(titular) && t.papel == 'gestor_nsi'
        && (v.get('operacoesVersao','') != 'v1' || t.get('operacoesVersao','') == 'v1')
        && t.orgaoId == v.orgaoId && v.inicio >= t.inicio && v.fim <= t.fim && v.revisao <= t.revisao && v.acoes.hasOnly(t.acoes)
        && (t.setoresIds.size() == 0 || (v.setoresIds.size() > 0 && v.setoresIds.hasOnly(t.setoresIds)));
    }
    function accessActive() {
      let user = profile();
      let v = user.get('acessoInstitucional', {});
      return baseAccessActive(user)
        && (v.papel != 'grgd' || user.get('tipoUsuario', '') == 'interno')
        && (v.papel != 'substituto' || validSubstitute(v));
    }
    function institutionalAction(action) {
      let v = profile().get('acessoInstitucional', null);
      return v != null && action in v.acoes && accessActive();
    }
    function grgdAction(action) {
      let v = profile().get('acessoInstitucional', null);
      return v != null && v.papel == 'grgd' && action in v.acoes && accessActive();
    }
    function scopedRecord(data) {
      let v = profile().acessoInstitucional;
      return accessActive() && data.get('orgaoId', '') == v.orgaoId && v.orgaoId != ''
        && (v.setoresIds.size() == 0 || data.get('setorId', '') in v.setoresIds);
    }
    function canReadModule(module) {
      return isAdmin() || (active() && !hasInstitutionalAccess() && module != 'usuarios'
        && (profile().get('tipoUsuario', '') != 'externo' || module == 'eventos')
        && module in profile().get('modulosPermitidos', profile().get('tipoUsuario', '') == '' ? ['dashboard','demandas','eventos'] : []))
        || grgdAction(module + '.consultar') || (module == 'eventos' && institutionalAction('eventos.consultar'));
    }
    function canWriteBusiness(module, action) { return isAdmin() || (grgdAction(module + '.' + action) && module + '.consultar' in profile().acessoInstitucional.acoes); }
    function validSectorId(id, orgaoId) {
      let setor = get(/databases/$(database)/documents/setores/$(id)).data;
      return setor != null && setor.orgaoId == orgaoId && setor.ativo == true;
    }
    function validSector(v, index) {
      return v.setoresIds.size() <= index || (v.setoresIds[index] is string && validSectorId(v.setoresIds[index], v.orgaoId));
    }
    function validAccess(user) {
      let v = user.get('acessoInstitucional', null);
      return v == null || (v is map && user.perfil != 'admin'
        && v.keys().hasOnly(['papel','orgaoId','setoresIds','situacao','inicio','fim','revisao','titularUid','acoes','aprovacaoGrgd','aprovacaoAutoridade','registradoPorUid','registradoEm','operacoesVersao'])
        && v.papel in ['grgd','gestor_nsi','substituto','auditoria']
        && v.get('operacoesVersao','') in ['','v1'] && (v.get('operacoesVersao','') != 'v1' || v.papel in ['gestor_nsi','substituto'])
        && v.situacao in ['pendente','aprovado','suspenso'] && v.orgaoId is string && v.orgaoId.size() <= 1500
        && v.setoresIds is list && v.setoresIds.size() <= 5 && v.acoes is list
        && v.inicio is int && v.fim is int && v.revisao is int
        && v.fim > v.inicio && v.revisao > v.inicio && v.revisao <= v.fim
        && v.registradoPorUid is string && v.registradoEm is timestamp && v.titularUid is string && (v.papel != 'substituto' || v.titularUid != user.uid)
        && v.get('aprovacaoGrgd', {}).keys().hasOnly(['responsavel','referencia']) && v.get('aprovacaoAutoridade', {}).keys().hasOnly(['responsavel','referencia'])
        && v.get('aprovacaoGrgd', {}).get('responsavel', '') is string && v.get('aprovacaoGrgd', {}).get('responsavel', '').size() <= 150
        && v.get('aprovacaoGrgd', {}).get('referencia', '') is string && v.get('aprovacaoGrgd', {}).get('referencia', '').size() <= 300
        && v.get('aprovacaoAutoridade', {}).get('responsavel', '') is string && v.get('aprovacaoAutoridade', {}).get('responsavel', '').size() <= 150
        && v.get('aprovacaoAutoridade', {}).get('referencia', '') is string && v.get('aprovacaoAutoridade', {}).get('referencia', '').size() <= 300
        && (v.papel == 'grgd' ? (user.tipoUsuario == 'interno' && v.orgaoId == '' && v.setoresIds.size() == 0 && v.acoes.hasOnly(['demandas.consultar','demandas.criar','demandas.editar','clientes.consultar','clientes.criar','clientes.editar','eventos.consultar','eventos.criar','eventos.editar','locais.consultar','locais.criar','locais.editar','fornecedores.consultar','fornecedores.criar','fornecedores.editar','bases.consultar','bases.criar','bases.editar','relatorios.consultar']))
          : ((v.situacao != 'aprovado' || (v.orgaoId != '' && exists(/databases/$(database)/documents/orgaos/$(v.orgaoId))))
            && (v.papel == 'auditoria' ? v.acoes.hasOnly(['auditoria.consultar','relatorios.consultar'])
              : v.acoes.hasOnly(['orgao.consultar','participantes.consultar','participantes.cadastrar','participantes.editar','eventos.consultar','inscricoes.consultar','inscricoes.criar','inscricoes.cancelar','comprovantes.consultar']))))
        && (v.situacao != 'aprovado' || (validSector(v,0) && validSector(v,1) && validSector(v,2) && validSector(v,3) && validSector(v,4)))
        && (v.situacao != 'aprovado' || (v.acoes.size() > 0 && (v.papel != 'substituto' || validSubstitute(v)))));
    }
    function validAccessRegistration(data, previous) {
      let v = data.get('acessoInstitucional', null);
      return (previous == null && v == null) || (v != null && (v == previous || (v.registradoPorUid == request.auth.uid && v.registradoEm == request.time)));
    }
    function validPhoto(value) {
      return value is string && value.size() <= 45000
        && (value == '' || value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }
    function validPersonal(data) {
      return data.keys().hasOnly(['telefone','endereco','atualizadoEm'])
        && data.telefone is string && data.telefone.size() <= 40
        && data.endereco is string && data.endereco.size() <= 400
        && data.atualizadoEm is string && data.atualizadoEm.size() <= 40;
    }
    function validIdentity(data, uid) {
      let user = getAfter(/databases/$(database)/documents/usuarios/$(uid)).data;
      return data.keys().hasOnly(['uid','nome','fotoPerfil','tipoUsuario','ativo'])
        && data.uid == uid && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150
        && data.nome == user.nome && validPhoto(data.fotoPerfil) && data.fotoPerfil == user.get('fotoPerfil', '')
        && data.tipoUsuario in ['','interno','externo'] && data.tipoUsuario == user.get('tipoUsuario', '')
        && data.ativo is bool && data.ativo == user.get('ativo', true);
    }
    function validUser(data, uid) {
      return data.uid == uid && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150
        && data.email is string && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && data.tipoUsuario in ['interno','externo'] && data.ativo is bool
        && data.perfil in ['admin','comum'] && (data.perfil != 'admin' || data.tipoUsuario == 'interno')
        && data.get('excluido', false) is bool && (data.get('excluido', false) != true || data.ativo == false)
        && data.modulosPermitidos is list
        && data.modulosPermitidos.hasOnly(['dashboard','demandas','clientes','eventos','locais','fornecedores','usuarios','bases'])
        && (data.perfil == 'admin' || !data.modulosPermitidos.hasAny(['usuarios']))
        && (data.tipoUsuario != 'externo' || data.modulosPermitidos.hasOnly(['eventos']))
        && validAccess(data) && validPhoto(data.get('fotoPerfil', '')) && !data.keys().hasAny(['senha','password']);
    }
    function canReadEvent(data) {
      return isAdmin() || grgdAction('eventos.consultar') || data.get('eventoPublico', false) == true
        || (institutionalAction('eventos.consultar') && profile().acessoInstitucional.orgaoId in data.get('orgaosElegiveis', []))
        || (!hasInstitutionalAccess() && (
        !('gruposPermitidos' in data) || data.gruposPermitidos.size() == 0
        || (data.gruposPermitidos is list && data.gruposPermitidos.hasAny(profile().get('grupos', [])))));
    }
    function recentAuthentication() {
      return signedIn() && request.auth.token.get('auth_time', 0) is int
        && request.auth.token.get('auth_time', 0) <= request.time.toMillis() / 1000
        && request.time.toMillis() / 1000 - request.auth.token.get('auth_time', 0) < 300;
    }
    function auditedUserDeletion(uid) {
      let auditPath = /databases/$(database)/documents/historicoAlteracoes/$(request.resource.data.get('ultimaAuditoriaId', 'ausente'));
      let audit = getAfter(auditPath).data;
      return !exists(auditPath) && audit.autorUid == request.auth.uid && audit.criadoEm == request.time
        && audit.colecao == 'usuarios' && audit.registroId == uid && audit.acao == 'excluir_usuario'
        && audit.campos.hasAny(['excluido']);
    }
    function auditScopeRecord(data) {
      let path = /databases/$(database)/documents/$(data.colecao)/$(data.registroId);
      let item = data.acao == 'excluir' ? get(path).data : getAfter(path).data;
      return item != null && data.get('orgaoId', '') != '' && data.orgaoId == item.get('orgaoId', '')
        && (!('setorId' in data) || data.setorId == item.get('setorId', ''));
    }
    function validAuditScope(data) {
      return !data.keys().hasAny(['orgaoId','setorId']) || auditScopeRecord(data);
    }
    function ownRegistrationAudit(data) {
      let path = /databases/$(database)/documents/inscricoes/$(data.registroId);
      let item = data.acao == 'excluir' ? get(path).data : getAfter(path).data;
      return !hasInstitutionalAccess() && item != null && item.uid == request.auth.uid;
    }
    function managedEvent(e) { return e.get('modeloInscricao', '') == 'institucional-v1'; }
    function managerAction(action, data) {
      let v = profile().get('acessoInstitucional', {});
      return v.get('papel', '') in ['gestor_nsi','substituto'] && v.get('operacoesVersao','') == 'v1' && action in v.acoes && accessActive()
        && (action.matches('^participantes[.].*') ? 'participantes.consultar' in v.acoes
          : v.acoes.hasAll(['inscricoes.consultar','eventos.consultar']) && (action != 'inscricoes.criar' || 'participantes.consultar' in v.acoes))
        && data.orgaoId == v.orgaoId && (v.setoresIds.size() == 0 || data.setorId in v.setoresIds);
    }
    function participantKey(data) { return hashing.sha256(data.orgaoId + '|' + data.emailInstitucional).toHexString().lower(); }
    function enrollmentKey(data) { return data.eventId + '__' + hashing.sha256(data.emailInstitucional).toHexString().lower(); }
    function participantChangedFields(data) {
      return (resource == null ? data.keys().toSet() : data.diff(resource.data).affectedKeys())
        .difference(['criadoEm','criadoPorUid','atualizadoEm','atualizadoPorUid','ultimaAuditoriaId'].toSet());
    }
    function newAuditMatches(data, col, id, action) {
      let path = /databases/$(database)/documents/historicoAlteracoes/$(data.ultimaAuditoriaId);
      let log = getAfter(path).data;
      return !exists(path) && log.autorUid == request.auth.uid && log.criadoEm == request.time
        && log.colecao == col && log.registroId == id && log.acao == action
        && log.orgaoId == data.orgaoId && log.setorId == data.setorId
        && log.campos is list && (col == 'colaboradores' ? log.campos.toSet() == participantChangedFields(data) : log.campos == ['situacao']);
    }
    function portalAuditKind(data) { return data.colecao == 'colaboradores' || data.acao in ['inscrever','cancelar_inscricao']; }
    function portalAuditMatches(id, data) {
      let item = data.colecao in ['colaboradores','inscricoes'] ? getAfter(/databases/$(database)/documents/$(data.colecao)/$(data.registroId)).data : null;
      return item != null
        && item.get('ultimaAuditoriaId','') == id && item.get('atualizadoPorUid','') == request.auth.uid && item.get('atualizadoEm',null) == request.time
        && data.orgaoId == item.orgaoId && data.setorId == item.setorId;
    }
    // A projeção compartilha somente contato institucional; nunca perfil, UID de login ou dados privados.
    function contactProjectionMatches(data, id) {
      let c = getAfter(/databases/$(database)/documents/contatosColaboradores/$(id)).data;
      let funcoes=data.get('funcoesContato',[]);
      // Igualdade do mapa inteiro valida os valores e recusa campos extras com menos expressões.
      return c == {'nome':data.nome,'emailInstitucional':data.emailInstitucional,'telefone':data.telefone,
        'cargo':data.cargo,'orgaoId':data.orgaoId,'setorId':data.setorId,'ativo':data.ativo,
        'validadeCadastro':data.get('validadeCadastro',null),'funcoesContato':funcoes,
        'divulgavel':funcoes.size()>0,'origemAuditoriaId':data.ultimaAuditoriaId,'atualizadoEm':data.atualizadoEm};
    }
    function maintainContactProjection(data,id) {
      let path = /databases/$(database)/documents/contatosColaboradores/$(id);
      // O log da origem é novo neste envio (newAuditMatches); a projeção precisa apontar para ele.
      // A regra da projeção valida o mapa inteiro, evitando repetir essa comparação aqui.
      return (!exists(path) && !existsAfter(path)) || getAfter(path).data.origemAuditoriaId == data.ultimaAuditoriaId;
    }
    function participantUserLinkMatches(data,id) {
      let previous = resource == null ? '' : resource.data.get('usuarioUid','');
      let next = data.get('usuarioUid','');
      return previous == next || (isAdmin()
        && (next == '' || getAfter(/databases/$(database)/documents/usuarios/$(next)).data.get('colaboradorId','') == id)
        && (previous == '' || getAfter(/databases/$(database)/documents/usuarios/$(previous)).data.get('colaboradorId','') != id));
    }
    function userParticipantLinkMatches(data,uid) {
      let previous = resource == null ? '' : resource.data.get('colaboradorId','');
      let next = data.get('colaboradorId','');
      let path = /databases/$(database)/documents/historicoAlteracoes/$(data.get('ultimaAuditoriaId','ausente'));
      let log = getAfter(path).data;
      return previous == next || (isAdmin() && next is string && next.size() <= 150
        && (next == '' || getAfter(/databases/$(database)/documents/colaboradores/$(next)).data.get('usuarioUid','') == uid)
        && (previous == '' || getAfter(/databases/$(database)/documents/colaboradores/$(previous)).data.get('usuarioUid','') != uid)
        && !exists(path) && log.autorUid == request.auth.uid && log.criadoEm == request.time
        && log.colecao == 'usuarios' && log.registroId == uid && log.campos.hasAny(['colaboradorId']));
    }
    function validContactRef(data,key,id) {
      let value=data.get('contatosVinculados',{}).get(key,'auto');
      let previous=resource == null ? 'auto' : resource.data.get('contatosVinculados',{}).get(key,'auto');
      return value is string && (value in ['auto','manual'] || value == previous
        || (get(/databases/$(database)/documents/contatosColaboradores/$(value)).data.orgaoId == id
          && get(/databases/$(database)/documents/contatosColaboradores/$(value)).data.divulgavel == true));
    }
    function validOrgContacts(data,id) {
      return data.get('contatosVinculados',{}) is map
        && data.get('contatosVinculados',{}).keys().hasOnly(['orgao','nsi','telematica','si','sei','focal'])
        && validContactRef(data,'orgao',id) && validContactRef(data,'nsi',id) && validContactRef(data,'telematica',id)
        && validContactRef(data,'si',id) && validContactRef(data,'sei',id) && validContactRef(data,'focal',id);
    }
    function participantSectorInScope(data) {
      let v=profile().acessoInstitucional;
      // managerAction já validou identidade, vínculo, titular e setor de origem nesta escrita.
      return v.setoresIds.size() == 0 || data.setorId in v.setoresIds;
    }
    function validParticipant(data, id) {
      let funcoes=data.get('funcoesContato',[]);
      let usuarioUid=data.get('usuarioUid','');
      let validade=data.get('validadeCadastro',null);
      return data.keys().hasOnly(['nome','emailInstitucional','orgaoId','setorId','telefone','cargo','matricula','ativo','validadeCadastro','funcoesContato','usuarioUid','criadoEm','criadoPorUid','atualizadoEm','atualizadoPorUid','ultimaAuditoriaId'])
        && data.get('matricula','') is string && data.get('matricula','').size() <= 50
        && data.nome is string && data.nome.size() > 1 && data.nome.size() <= 150
        && data.emailInstitucional is string && data.emailInstitucional.size() <= 254
        && data.emailInstitucional == data.emailInstitucional.lower().trim()
        && data.emailInstitucional.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
        && data.orgaoId is string && data.setorId is string && id == participantKey(data)
        && data.telefone is string && data.telefone.size() <= 40 && data.cargo is string && data.cargo.size() <= 150
        && (validade == null || (validade is int && validade > 0))
        && funcoes is list && funcoes.size() <= 6
        && funcoes.hasOnly(['orgao','nsi','telematica','si','sei','focal'])
        && usuarioUid is string && usuarioUid.size() <= 150
        && participantUserLinkMatches(data,id) && maintainContactProjection(data,id)
        && data.ativo is bool && data.criadoEm is timestamp && data.criadoPorUid is string
        && data.atualizadoEm == request.time && data.atualizadoPorUid == request.auth.uid
        && data.ultimaAuditoriaId is string;
    }
    function validEventPolicy(e) {
      return managedEvent(e) && e.inscricoesAbertas is bool && e.orgaosElegiveis is list
        && e.orgaosElegiveis.size() > 0 && e.orgaosElegiveis.size() <= 100
        && e.inscricaoInicio is int && e.inscricaoFim is int && e.inscricaoFim > e.inscricaoInicio
        && e.limiteVagas is int && e.limiteVagas > 0 && e.inscritosCount is int
        && e.inscritosCount >= 0 && e.inscritosCount <= e.limiteVagas;
    }
    function enrollmentOpen(e, orgaoId) {
      return validEventPolicy(e) && e.inscricoesAbertas && orgaoId in e.orgaosElegiveis
        && e.inscricaoInicio <= request.time.toMillis() && e.inscricaoFim > request.time.toMillis()
        && !(e.get('status','') in ['Cancelado','Realizado']);
    }
    function validEnrollment(data, id) {
      return data.keys().hasOnly(['modeloInscricao','eventId','participanteId','emailInstitucional','participanteNome','orgaoId','setorId','eventoTitulo','eventoData','situacao','protocolo','criadoEm','criadoPorUid','atualizadoEm','atualizadoPorUid','ultimaAuditoriaId'])
        && data.modeloInscricao == 'institucional-v1' && data.eventId is string && data.eventId.size() > 0
        && data.participanteId is string && data.emailInstitucional is string
        && data.participanteNome is string && data.eventoTitulo is string && data.eventoData is string
        && data.orgaoId is string && data.setorId is string && data.protocolo == id && id == enrollmentKey(data)
        && data.situacao in ['confirmada','cancelada'] && data.criadoEm is timestamp && data.criadoPorUid is string
        && data.atualizadoEm == request.time && data.atualizadoPorUid == request.auth.uid;
    }
    function enrollmentParticipantMatches(data) {
      let p = get(/databases/$(database)/documents/colaboradores/$(data.participanteId)).data;
      return p != null && p.ativo && p.orgaoId == data.orgaoId && p.setorId == data.setorId
        && validSectorId(p.setorId,p.orgaoId)
        && p.emailInstitucional == data.emailInstitucional && p.nome == data.participanteNome;
    }
    function enrollmentCounterMatches(data, id, delta) {
      let path = /databases/$(database)/documents/eventos/$(data.eventId);
      let old = get(path).data;
      let next = getAfter(path).data;
      return managedEvent(old) && next.inscritosCount == old.inscritosCount + delta && next.ultimaInscricaoId == id
        && next.inscritosCount >= 0 && next.inscritosCount <= old.limiteVagas
        && (delta < 0 || (enrollmentOpen(old, data.orgaoId) && data.eventoTitulo == old.titulo && data.eventoData == old.get('dataInicio','')));
    }
    function validCounterChange(eventId) {
      let id = request.resource.data.ultimaInscricaoId;
      let path = /databases/$(database)/documents/inscricoes/$(id);
      let old = exists(path) ? get(path).data : null;
      let next = getAfter(path).data;
      let delta = next.situacao == 'confirmada' ? 1 : -1;
      return active() && managedEvent(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscritosCount','ultimaInscricaoId'])
        && next.eventId == eventId && next.modeloInscricao == 'institucional-v1'
        && ((delta == 1 && (old == null || old.situacao == 'cancelada')) || (delta == -1 && old != null && old.situacao == 'confirmada'))
        && request.resource.data.inscritosCount == resource.data.inscritosCount + delta
        && request.resource.data.inscritosCount >= 0 && request.resource.data.inscritosCount <= resource.data.limiteVagas;
    }
    match /historicoAlteracoes/{id} {
      allow read: if isAdmin() || (institutionalAction('auditoria.consultar') && scopedRecord(resource.data));
      allow create: if active()
        && request.resource.data.keys().hasOnly(['autorUid','autorNome','criadoEm','colecao','registroId','registroNome','acao','campos','orgaoId','setorId'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorNome == (profile().get('nome', '') != '' ? profile().nome : request.auth.token.get('email', request.auth.uid))
        && request.resource.data.criadoEm == request.time
        && request.resource.data.registroId is string && request.resource.data.registroId.size() > 0 && request.resource.data.registroId.size() <= 1500
        && request.resource.data.registroNome is string && request.resource.data.registroNome.size() <= 180
        && request.resource.data.acao in ['criar','editar','excluir','excluir_usuario','alterar_senha','inscrever','cancelar_inscricao']
        && request.resource.data.campos is list && request.resource.data.campos.size() <= 128
        && (portalAuditKind(request.resource.data) ? portalAuditMatches(id, request.resource.data) : ((isAdmin() && request.resource.data.colecao in ['usuarios','orgaos','demandas','eventos','locais','fornecedores','bases','grupos','inscricoes','perfilPrivado','setores'])
          || (request.resource.data.colecao in ['demandas','orgaos','eventos','locais','fornecedores','bases'] && request.resource.data.acao in ['criar','editar'] && canWriteBusiness(request.resource.data.colecao == 'orgaos' ? 'clientes' : request.resource.data.colecao, request.resource.data.acao == 'criar' ? 'criar' : 'editar'))
          || (request.resource.data.colecao in ['usuarios','perfilPrivado'] && request.resource.data.registroId == request.auth.uid && request.resource.data.acao in ['criar','editar'])
          || (request.resource.data.colecao == 'inscricoes' && canReadModule('eventos') && request.resource.data.acao in ['criar','excluir'] && ownRegistrationAudit(request.resource.data))
          || (request.resource.data.colecao == 'autenticacao' && request.resource.data.registroId == request.auth.uid && request.resource.data.acao == 'alterar_senha' && recentAuthentication())))
        && validAuditScope(request.resource.data);
      // Histórico somente acrescentado: nem administradores podem editar ou apagar entradas.
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && validUser(request.resource.data, uid) && validAccessRegistration(request.resource.data, null) && userParticipantLinkMatches(request.resource.data,uid);
      allow update: if ((isAdmin()
          && ((validUser(request.resource.data, uid) && validAccessRegistration(request.resource.data, resource.data.get('acessoInstitucional', null)))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','excluido','atualizadoEm','editadoPor','editadoPorUid','ultimaAuditoriaId']) && request.resource.data.ativo is bool
              && request.resource.data.get('excluido', false) is bool
              && (request.resource.data.get('excluido', false) != true || request.resource.data.ativo == false)))
          && (request.auth.uid != uid || (request.resource.data.ativo == true && request.resource.data.perfil == 'admin' && request.resource.data.tipoUsuario == 'interno')))
        || (active() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','fotoPerfil','perfilAtualizadoEm','ultimaAuditoriaId'])
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 150
          && validPhoto(request.resource.data.get('fotoPerfil', ''))
          && request.resource.data.get('perfilAtualizadoEm', '') is string && request.resource.data.get('perfilAtualizadoEm', '').size() <= 40))
        && userParticipantLinkMatches(request.resource.data,uid)
        && (request.resource.data.get('excluido', false) != true || resource.data.get('excluido', false) == true
          || (recentAuthentication() && auditedUserDeletion(uid)));
      // Inativar o perfil mantém os vínculos e o histórico.
      allow delete: if false;
    }
    match /usuarios/{uid}/privado/{registro} {
      allow read: if active() && request.auth.uid == uid && registro == 'perfil';
      allow create, update: if active() && request.auth.uid == uid && registro == 'perfil' && validPersonal(request.resource.data);
      allow delete: if false;
    }
    match /identidadesUsuarios/{uid} {
      allow read: if active() && (isAdmin() || request.auth.uid == uid
        || (resource.data.tipoUsuario == 'interno' && resource.data.ativo == true
          && ((!hasInstitutionalAccess() && (profile().get('tipoUsuario', '') == 'interno' || canReadModule('eventos')))
            || (accessActive() && profile().acessoInstitucional.papel == 'grgd'))));
      allow create, update: if (isAdmin() || (active() && request.auth.uid == uid)) && validIdentity(request.resource.data, uid);
      allow delete: if false;
    }
    match /grupos/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin() && recentAuthentication();
    }
    match /eventos/{id} {
      allow read: if canReadModule('eventos') && canReadEvent(resource.data);
      allow create: if canWriteBusiness('eventos','criar') && (!managedEvent(request.resource.data)
        ? !request.resource.data.keys().hasAny(['modeloInscricao','inscritosCount','ultimaInscricaoId'])
        : validEventPolicy(request.resource.data) && request.resource.data.inscritosCount == 0 && !request.resource.data.keys().hasAny(['ultimaInscricaoId']));
      allow update: if (managedEvent(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['inscritosCount','ultimaInscricaoId']) && validCounterChange(id)) || (canWriteBusiness('eventos','editar')
        && request.resource.data.get('modeloInscricao','') == resource.data.get('modeloInscricao','')
        && (!managedEvent(resource.data) || (validEventPolicy(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inscritosCount','ultimaInscricaoId']))));
      allow delete: if isAdmin() && recentAuthentication() && !managedEvent(resource.data);
    }
    match /inscricoes/{id} {
      allow read: if resource != null && (isAdmin() || grgdAction('relatorios.consultar')
        || ((institutionalAction('inscricoes.consultar') || institutionalAction('comprovantes.consultar') || institutionalAction('relatorios.consultar')) && scopedRecord(resource.data))
        || (!hasInstitutionalAccess() && canReadModule('eventos') && resource.data.uid == request.auth.uid));
      // Permite verificar apenas a ausência de um ID determinístico. Registros de outro órgão continuam negados.
      allow get: if resource == null && institutionalAction('inscricoes.criar') && profile().acessoInstitucional.get('operacoesVersao','') == 'v1';
      allow create: if request.resource.data.get('modeloInscricao','') == 'institucional-v1'
        ? (managerAction('inscricoes.criar',request.resource.data) && validEnrollment(request.resource.data,id)
          && request.resource.data.situacao == 'confirmada' && request.resource.data.criadoEm == request.time && request.resource.data.criadoPorUid == request.auth.uid
          && enrollmentParticipantMatches(request.resource.data) && enrollmentCounterMatches(request.resource.data,id,1)
          && newAuditMatches(request.resource.data,'inscricoes',id,'inscrever'))
        : (!hasInstitutionalAccess() && canReadModule('eventos') && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['eventId','uid','nome','email','criadoEm'])
          && request.resource.data.eventId is string
          && exists(/databases/$(database)/documents/eventos/$(request.resource.data.eventId))
          && !managedEvent(get(/databases/$(database)/documents/eventos/$(request.resource.data.eventId)).data)
          && canReadEvent(get(/databases/$(database)/documents/eventos/$(request.resource.data.eventId)).data));
      allow update: if resource.data.get('modeloInscricao','') == 'institucional-v1' && validEnrollment(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao','participanteNome','eventoTitulo','eventoData','atualizadoEm','atualizadoPorUid','ultimaAuditoriaId'])
        && (request.resource.data.situacao == 'cancelada'
          ? (resource.data.situacao == 'confirmada' && (isAdmin() || managerAction('inscricoes.cancelar',resource.data))
            && request.resource.data.participanteNome == resource.data.participanteNome && request.resource.data.eventoTitulo == resource.data.eventoTitulo && request.resource.data.eventoData == resource.data.eventoData
            && enrollmentCounterMatches(request.resource.data,id,-1) && newAuditMatches(request.resource.data,'inscricoes',id,'cancelar_inscricao'))
          : (resource.data.situacao == 'cancelada' && managerAction('inscricoes.criar',resource.data)
            && enrollmentParticipantMatches(request.resource.data) && enrollmentCounterMatches(request.resource.data,id,1) && newAuditMatches(request.resource.data,'inscricoes',id,'inscrever')));
      allow delete: if resource.data.get('modeloInscricao','') != 'institucional-v1'
        && (isAdmin() || (!hasInstitutionalAccess() && canReadModule('eventos') && resource.data.uid == request.auth.uid));
    }
    match /setores/{id} {
      allow read: if isAdmin() || canReadModule('clientes') || (accessActive() && resource.data.orgaoId == profile().acessoInstitucional.orgaoId);
      allow create, update: if isAdmin() && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 150
        && request.resource.data.ativo is bool && request.resource.data.orgaoId is string
        && exists(/databases/$(database)/documents/orgaos/$(request.resource.data.orgaoId));
      allow delete: if false;
    }
    match /colaboradores/{id} {
      allow read: if resource != null && (isAdmin() || (institutionalAction('participantes.consultar') && scopedRecord(resource.data)));
      allow get: if resource == null && (isAdmin() || (institutionalAction('participantes.cadastrar') && profile().acessoInstitucional.get('operacoesVersao','') == 'v1'));
      allow create: if (isAdmin() || managerAction('participantes.cadastrar',request.resource.data)) && validParticipant(request.resource.data,id)
        && validSectorId(request.resource.data.setorId,request.resource.data.orgaoId)
        && request.resource.data.criadoEm == request.time && request.resource.data.criadoPorUid == request.auth.uid
        && newAuditMatches(request.resource.data,'colaboradores',id,'criar');
      function validUpdate() {
        let admin=isAdmin();
        let antes=resource.data;
        let depois=request.resource.data;
        return (admin || managerAction('participantes.editar',antes)) && validParticipant(depois,id)
          && depois.diff(antes).affectedKeys().hasOnly(['nome','telefone','cargo','matricula','ativo','setorId','validadeCadastro','funcoesContato','usuarioUid','atualizadoEm','atualizadoPorUid','ultimaAuditoriaId'])
          && (depois.setorId == antes.setorId || (validSectorId(depois.setorId,depois.orgaoId) && (admin || participantSectorInScope(depois))))
          && (admin || depois.get('usuarioUid','') == antes.get('usuarioUid',''))
          && newAuditMatches(depois,'colaboradores',id,'editar');
      }
      allow update: if validUpdate();
      allow delete: if false;
    }
    match /contatosColaboradores/{id} {
      // A própria origem precisa mudar neste envio e passar pelas regras de colaboradores.
      // Evita repetir a validação pesada do substituto na escrita da projeção derivada.
      function sourceChangedInRequest() {
        let path=/databases/$(database)/documents/colaboradores/$(id);
        let source=getAfter(path).data;
        return signedIn() && source.atualizadoPorUid == request.auth.uid && source.atualizadoEm == request.time
          && (!exists(path) || get(path).data.get('ultimaAuditoriaId','') != source.ultimaAuditoriaId)
          && contactProjectionMatches(source,id);
      }
      allow read: if isAdmin() || (canReadModule('clientes') && resource.data.divulgavel == true);
      allow create, update: if sourceChangedInRequest();
      allow delete: if false;
    }
    match /{col}/{id} {
      // A regra genérica não se aplica a usuários, grupos, eventos ou inscrições.
      function businessCollection() { return col in ['demandas','orgaos','locais','fornecedores','bases']; }
      function moduleName() { return col == 'orgaos' ? 'clientes' : col; }
      function visibleRecord(data) {
        return isAdmin() || data.get('publico', false) == true || data.get('restrito', false) != true
          || (data.get('gruposPermitidos', null) is list && (data.gruposPermitidos.size() == 0 || data.gruposPermitidos.hasAny(profile().get('grupos', []))))
          || (data.get('tagsPermitidas', []) is list && data.get('tagsPermitidas', []).hasAny(profile().get('tags', [])))
          || (data.get('orgao', null) != null && data.orgao == profile().get('orgao', ''))
          || (data.get('orgaosPermitidos', []) is list && data.get('orgaosPermitidos', []).hasAny([profile().get('orgao', '')]));
      }
      allow read: if businessCollection() && canReadModule(moduleName()) && visibleRecord(resource.data)
        || (col == 'orgaos' && institutionalAction('orgao.consultar') && id == profile().acessoInstitucional.orgaoId);
      allow create: if businessCollection() && canWriteBusiness(moduleName(),'criar') && (col != 'orgaos' || validOrgContacts(request.resource.data,id));
      allow update: if businessCollection() && canWriteBusiness(moduleName(),'editar') && (col != 'orgaos' || validOrgContacts(request.resource.data,id));
      allow delete: if businessCollection() && isAdmin() && recentAuthentication();
    }
  }
}

