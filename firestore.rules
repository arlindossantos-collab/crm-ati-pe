rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && profile().get('ativo', true) == true;
    }
    function isAdmin() {
      // Administradores antigos continuam acessando até a classificação manual.
      return active() && profile().get('tipoUsuario', '') != 'externo' && profile().get('perfil', '') == 'admin';
    }
    function canReadModule(module) {
      return isAdmin() || (active() && module != 'usuarios'
        && (profile().get('tipoUsuario', '') != 'externo' || module == 'eventos')
        && module in profile().get('modulosPermitidos', profile().get('tipoUsuario', '') == '' ? ['dashboard','demandas','eventos'] : []));
    }
    function validPhoto(value) {
      return value is string && value.size() <= 45000
        && (value == '' || value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }
    function validPersonal(data) {
      return data.keys().hasOnly(['telefone','endereco','atualizadoEm'])
        && data.telefone is string && data.telefone.size() <= 40
        && data.endereco is string && data.endereco.size() <= 400
        && data.atualizadoEm is string && data.atualizadoEm.size() <= 40;
    }
    function validIdentity(data, uid) {
      let user = getAfter(/databases/$(database)/documents/usuarios/$(uid)).data;
      return data.keys().hasOnly(['uid','nome','fotoPerfil','tipoUsuario','ativo'])
        && data.uid == uid && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150
        && data.nome == user.nome && validPhoto(data.fotoPerfil) && data.fotoPerfil == user.get('fotoPerfil', '')
        && data.tipoUsuario in ['','interno','externo'] && data.tipoUsuario == user.get('tipoUsuario', '')
        && data.ativo is bool && data.ativo == user.get('ativo', true);
    }
    function validUser(data, uid) {
      return data.uid == uid && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150
        && data.email is string && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && data.tipoUsuario in ['interno','externo'] && data.ativo is bool
        && data.perfil in ['admin','comum'] && (data.perfil != 'admin' || data.tipoUsuario == 'interno')
        && data.modulosPermitidos is list
        && data.modulosPermitidos.hasOnly(['dashboard','demandas','clientes','eventos','locais','fornecedores','usuarios','bases'])
        && (data.perfil == 'admin' || !data.modulosPermitidos.hasAny(['usuarios']))
        && (data.tipoUsuario != 'externo' || data.modulosPermitidos.hasOnly(['eventos']))
        && validPhoto(data.get('fotoPerfil', '')) && !data.keys().hasAny(['senha','password']);
    }
    function canReadEvent(data) {
      return isAdmin() || data.get('eventoPublico', false) == true
        || !('gruposPermitidos' in data) || data.gruposPermitidos.size() == 0
        || (data.gruposPermitidos is list && data.gruposPermitidos.hasAny(profile().get('grupos', [])));
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && validUser(request.resource.data, uid);
      allow update: if (isAdmin()
          && (validUser(request.resource.data, uid)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm','editadoPor','editadoPorUid']) && request.resource.data.ativo is bool))
          && (request.auth.uid != uid || (request.resource.data.ativo == true && request.resource.data.perfil == 'admin' && request.resource.data.tipoUsuario == 'interno')))
        || (active() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','fotoPerfil','perfilAtualizadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 150
          && validPhoto(request.resource.data.get('fotoPerfil', ''))
          && request.resource.data.get('perfilAtualizadoEm', '') is string && request.resource.data.get('perfilAtualizadoEm', '').size() <= 40);
      // Inativar o perfil mantém os vínculos e o histórico.
      allow delete: if false;
    }
    match /usuarios/{uid}/privado/{registro} {
      allow read: if active() && request.auth.uid == uid && registro == 'perfil';
      allow create, update: if active() && request.auth.uid == uid && registro == 'perfil' && validPersonal(request.resource.data);
      allow delete: if false;
    }
    match /identidadesUsuarios/{uid} {
      allow read: if active() && (isAdmin() || request.auth.uid == uid
        || (resource.data.tipoUsuario == 'interno' && resource.data.ativo == true
          && (profile().get('tipoUsuario', '') == 'interno' || canReadModule('eventos'))));
      allow create, update: if (isAdmin() || (active() && request.auth.uid == uid)) && validIdentity(request.resource.data, uid);
      allow delete: if false;
    }
    match /grupos/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /eventos/{id} {
      allow read: if canReadModule('eventos') && canReadEvent(resource.data);
      allow create, update, delete: if isAdmin();
    }
    match /inscricoes/{id} {
      allow read: if isAdmin() || (canReadModule('eventos') && resource.data.uid == request.auth.uid);
      allow create: if canReadModule('eventos') && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/eventos/$(request.resource.data.eventId))
        && canReadEvent(get(/databases/$(database)/documents/eventos/$(request.resource.data.eventId)).data);
      allow delete: if isAdmin() || (canReadModule('eventos') && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /{col}/{id} {
      // A regra genérica não se aplica a usuários, grupos, eventos ou inscrições.
      function businessCollection() { return col in ['demandas','orgaos','locais','fornecedores','bases']; }
      function moduleName() { return col == 'orgaos' ? 'clientes' : col; }
      function visibleRecord(data) {
        return isAdmin() || data.get('publico', false) == true || data.get('restrito', false) != true
          || (data.get('gruposPermitidos', null) is list && (data.gruposPermitidos.size() == 0 || data.gruposPermitidos.hasAny(profile().get('grupos', []))))
          || (data.get('tagsPermitidas', []) is list && data.get('tagsPermitidas', []).hasAny(profile().get('tags', [])))
          || (data.get('orgao', null) != null && data.orgao == profile().get('orgao', ''))
          || (data.get('orgaosPermitidos', []) is list && data.get('orgaosPermitidos', []).hasAny([profile().get('orgao', '')]));
      }
      allow read: if businessCollection() && canReadModule(moduleName()) && visibleRecord(resource.data);
      allow create, update, delete: if businessCollection() && isAdmin();
    }
  }
}

